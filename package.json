{
  "name": "monea-currency",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Monea Currency — 汇率换算 API + Apple 风格界面，部署在 Cloudflare Workers，数据来自 Frankfurter v2",
  "scripts": {
    "dev": "wrangler dev --live-reload --ip 0.0.0.0 --port 8790",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "node scripts/test-calculator-ui.mjs",
    "verify": "wrangler types --check && tsc --noEmit && vitest run && wrangler deploy --dry-run",
    "warm": "node scripts/warm.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "^5.20261031.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.5",
    "wrangler": "^4.156.0"
  }
}
