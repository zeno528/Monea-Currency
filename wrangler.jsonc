{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monea-currency",
  "main": "src/index.ts",
  "compatibility_date": "2025-07-01",
  "assets": {
    "directory": "./assets"
  },
  "observability": {
    "enabled": true
  },
  // 启用 Workers Caching：响应按 Cache-Control 头自动进 CDN 边沿，
  // 自动支持 stale-while-revalidate / stale-if-error，
  // 不再需要手写 caches.default.put / staleCacheKey 逻辑。
  "cache": {
    "enabled": true
  },
  // Cron Trigger 预热：每 3 小时拉一次 top-10 基础币全量汇率，
  // 写入 caches.default，消除首次冷启的 200-600ms 欧洲往返延迟。
  "triggers": {
    "crons": ["42 */3 * * *"]
  }
}
