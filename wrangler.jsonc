{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monea-currency",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "assets": {
    "directory": "./assets"
  },
  "observability": {
    "enabled": true
  },
  // 启用 Workers Caching：响应按 Cache-Control 头自动进 CDN 边沿，
  // 自动支持 stale-while-revalidate / stale-if-error，
  // 不再需要手写 caches.default.put / staleCacheKey 逻辑。
  "cache": {
    "enabled": true
  },
  // Cron Trigger 预热：每 3 小时刷新 USD、EUR、CNY、JPY、GBP、HKD、
  // AUD、CAD、CHF、SGD 这 10 个常用 base。
  // 经由 SELF service binding 调用自身 /latest 端点（走完整 fetch handler），
  // 让响应按 live-rate 策略的 Cache-Control 落进 CDN 边沿；长尾币种按需缓存。
  "triggers": {
    "crons": ["42 */3 * * *"]
  },
  // SELF service binding：让 cron 内部直接调用本 Worker 的 fetch handler，
  // 走 Service Bindings 通道而非公网回环；host 任意（service binding 只看 path），
  // 但 path 必须是 /latest?base=... 才会被本 Worker 的 router 命中。
  "services": [
    {
      "binding": "SELF",
      "service": "monea-currency"
    }
  ]
}
